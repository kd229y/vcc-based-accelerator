diff --git a/accel/scripts/mask_pts.py b/accel/scripts/mask_pts.py
new file mode 100644
index 0000000..017f8d9
--- /dev/null
+++ b/accel/scripts/mask_pts.py
@@ -0,0 +1,7 @@
+"""Source PTS trace files masked to the 11-bit in-cell offsets kept by cse_env_mem (format v0 + offsets)."""
+import sys
+trace, out = sys.argv[1], sys.argv[2]
+for p in ("p1", "p2"):
+    for f in ("ptx", "pty", "ptz"):
+        vals = [int(l, 16) & 0x7ff for l in open(f"{trace}/s0_{p}_{f}.hex") if l.strip()]
+        open(f"{out}/src_{p}_{f}.hex", "w").write("".join("%04x\n" % v for v in vals))
